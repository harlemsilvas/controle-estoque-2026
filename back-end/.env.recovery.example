# Copiar estas variaveis para o .env do backend (Linux e/ou Windows conforme a instancia).
# Ativar somente depois de configurar o remetente, credenciais e URL real.
PASSWORD_RECOVERY_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
APP_PUBLIC_URL=
# Somente para testes HTTP na LAN. Em producao usar HTTPS.
ALLOW_HTTP_PASSWORD_RECOVERY=false
